{
  "name": "@open-resource-discovery/provider-server",
  "version": "1.3.1",
  "description": "A CLI application or server that takes multiple ORD documents and other metadata files and exposes them as a ORD Provider implementation (ORD Document API)",
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=11.6"
  },
  "type": "module",
  "bin": "dist/cli.js",
  "files": ["dist/"],
  "scripts": {
    "prebuild": "node scripts/clean.mjs dist",
    "build": "tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
    "build:ui": "vite build",
    "build:all": "npm run build && npm run build:ui",
    "prepublishOnly": "npm run build:all",
    "deploy": "npm run build:all && npm prune --production && cf login -a https://api.cf.sap.hana.ondemand.com -o CORE_CF -s open-discovery && cf push && npm install",
    "start": "node dist/cli.js",
    "dev": "tsx watch ./src/cli.ts",
    "eslint": "npm run lint",
    "eslint:ci": "npm run lint",
    "prettier": "npm run format",
    "prettier:ci": "npm run format:check",
    "format": "biome format --write . && oxfmt --no-error-on-unmatched-pattern '**/*.{md,yml,yaml,css,scss,html}'",
    "test:ci": "vitest run --config vitest.backend.config.ts --coverage",
    "test:watch": "vitest --config vitest.backend.config.ts",
    "test": "vitest run --config vitest.backend.config.ts",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "coverage": "vitest run --config vitest.backend.config.ts --coverage",
    "prepare": "[ ! -z \"$CF_INSTANCE_IP\" ] || is-ci || husky",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format:check": "biome format . && oxfmt --check --no-error-on-unmatched-pattern '**/*.{md,yml,yaml,css,scss,html}'",
    "check:tooling": "npm run lint && npm run format:check",
    "test:coverage": "vitest run --config vitest.backend.config.ts --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-resource-discovery/provider-server.git"
  },
  "author": "SAP SE",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/auth": "5.1.2",
    "@fastify/basic-auth": "6.3.1",
    "@fastify/cors": "11.4.3",
    "@fastify/etag": "6.2.2",
    "@fastify/static": "10.1.12",
    "@fastify/websocket": "11.3.7",
    "@octokit/rest": "22.0.1",
    "@open-resource-discovery/specification": "1.17.1",
    "bcryptjs": "3.0.3",
    "commander": "15.1.0",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-raw-body": "6.0.3",
    "isomorphic-git": "1.44.18",
    "p-limit": "7.3.3",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0"
  },
  "devDependencies": {
    "@tanstack/react-router": "1.170.46",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@tsconfig/node26": "26.0.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "fetch-mock": "12.6.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsc-alias": "1.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.0.5",
    "@biomejs/biome": "2.6.4",
    "oxfmt": "0.75.0",
    "@vitest/coverage-v8": "5.0.5",
    "@open-resource-discovery/explorer": "0.2.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,html}": ["biome check --write --no-errors-on-unmatched"],
    "*.{md,yml,yaml}": ["oxfmt"]
  },
  "overrides": {
    "content-disposition": "3.0.0",
    "test-exclude": {
      ".": "8.0.0",
      "minimatch": "11.0.8"
    },
    "glob": "14.0.6",
    "js-yaml": "5.5.0",
    "esbuild": "0.28.2",
    "brace-expansion": "5.0.13",
    "fast-uri": "4.2.3",
    "find-my-way": "9.10.1",
    "hono": "4.13.16",
    "fast-xml-parser": "5.12.0",
    "seroval": "1.6.11",
    "undici": "8.12.4",
    "@scalar/json-magic": {
      "undici": "7.30.1"
    },
    "isomorphic-dompurify": {
      "undici": "7.30.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}