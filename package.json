{
  "name": "@open-resource-discovery/provider-server",
  "version": "1.2.5",
  "description": "A CLI application or server that takes multiple ORD documents and other metadata files and exposes them as a ORD Provider implementation (ORD Document API)",
  "engines": {
    "node": ">=24.10.7",
    "npm": ">=11.6.1"
  },
  "type": "module",
  "bin": "dist/cli.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
    "build:ui": "vite build",
    "build:all": "npm run build && npm run build:ui",
    "prepublishOnly": "npm run build:all",
    "deploy": "npm run build:all && npm prune --production && cf login -a https://api.cf.sap.hana.ondemand.com -o CORE_CF -s open-discovery && cf push && npm install",
    "start": "node dist/cli.js",
    "dev": "tsx watch ./src/cli.ts",
    "eslint": "eslint . --fix",
    "eslint:ci": "eslint .",
    "prettier": "prettier --write \"**/*.{json,yml,yaml,md}\"",
    "prettier:ci": "prettier --check \"**/*.{json,yml,yaml,md}\"",
    "format": "npm run prettier && npm run eslint",
    "test:ci": "jest --ci --collectCoverage",
    "test:watch": "jest --watchAll",
    "test": "npm run test:ci",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "coverage": "jest --coverage --maxWorkers=1",
    "prepare": "[ ! -z \"$CF_INSTANCE_IP\" ] || is-ci || husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-resource-discovery/provider-server.git"
  },
  "author": "SAP SE",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/auth": "5.1.2",
    "@fastify/basic-auth": "6.3.1",
    "@fastify/cors": "11.3.1",
    "@fastify/etag": "6.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@octokit/rest": "22.0.1",
    "@open-resource-discovery/explorer": "0.2.1",
    "@open-resource-discovery/specification": "1.16.4",
    "bcryptjs": "3.0.3",
    "commander": "15.0.0",
    "dotenv": "18.0.7",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.1",
    "fastify-raw-body": "6.0.1",
    "isomorphic-git": "1.43.0",
    "p-limit": "7.3.3",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0"
  },
  "devDependencies": {
    "@sap/eslint-config": "0.5.2",
    "@tanstack/react-router": "1.170.42",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@tsconfig/node24": "24.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.12.0",
    "fetch-mock": "12.6.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "jest": "30.5.2",
    "jest-cli": "30.5.2",
    "jest-fetch-mock": "4.2.0",
    "jest-junit": "17.0.0",
    "jest-watch-typeahead": "3.0.1",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.14",
    "tsc-alias": "1.9.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "./**/*.{js,ts}": [
      "eslint --quiet"
    ],
    "**/*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "content-disposition": "2.0.1",
    "test-exclude": "8.0.0",
    "glob": "13.0.6",
    "js-yaml": "5.4.2",
    "esbuild": "0.28.2",
    "brace-expansion": "5.0.12",
    "fast-uri": "4.2.1",
    "find-my-way": "9.9.0"
  }
}
